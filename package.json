{
  "name": "@onolys/common",
  "version": "0.4.1",
  "description": "Shared design tokens, styles, and React components for Onolys.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onolys/onolys-common.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/firebase": {
      "types": "./dist/auth/firebase.d.ts",
      "import": "./dist/auth/firebase.js"
    },
    "./auth/testing": {
      "types": "./dist/auth/testing.d.ts",
      "import": "./dist/auth/testing.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./theme-init.js": "./dist/theme-init.js",
    "./components.json": "./components.json"
  },
  "files": [
    "dist",
    "fonts",
    "components.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.0.0",
    "react-router": "^8.5.2",
    "@tanstack/react-query": "^5.108.1",
    "firebase": "^13.4.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  }
}
