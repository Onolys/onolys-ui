{
  "name": "@onolys/common",
  "version": "0.4.0",
  "description": "Shared design tokens, styles, and React components for Onolys.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onolys/onolys-common.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/firebase": {
      "types": "./dist/auth/firebase.d.ts",
      "import": "./dist/auth/firebase.js"
    },
    "./auth/testing": {
      "types": "./dist/auth/testing.d.ts",
      "import": "./dist/auth/testing.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./theme-init.js": "./dist/theme-init.js",
    "./components.json": "./components.json"
  },
  "files": [
    "dist",
    "fonts",
    "components.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run --passWithNoTests --config vitest.auth.config.ts",
    "build": "tsup && node scripts/copy-styles.mjs",
    "build:watch": "tsup --watch src --watch scripts --onSuccess \"node scripts/copy-styles.mjs\"",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "tokens:generate": "node --experimental-strip-types scripts/generate-tokens.mjs",
    "test:storybook": "npm run build:storybook && node --test test/storybook-coverage.test.mjs && node scripts/test-storybook-a11y.mjs",
    "test:storybook:negative": "node scripts/test-storybook-negative.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.0.0",
    "react-router": "^8.5.2",
    "@tanstack/react-query": "^5.108.1",
    "firebase": "^13.4.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "firebase": "13.4.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
