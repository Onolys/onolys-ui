{
  "name": "@onolys/ui",
  "version": "0.3.0",
  "description": "Shared design tokens, styles, and React components for Onolys.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onolys/onolys-ui.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./components.json": "./components.json",
    "./legacy.css": "./dist/legacy.css"
  },
  "files": [
    "dist",
    "fonts",
    "components.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  }
}
